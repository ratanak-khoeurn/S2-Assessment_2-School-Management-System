PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Matches your Midterm setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=school_management
DB_DIALECT=mysql

# Prisma MySQL Connection URL
DATABASE_URL="mysql://root:@127.0.0.1:3306/school_management"

# Session & JWT Secrets
SESSION_SECRET=your_session_secret
JWT_SECRET=your_jwt_secret

# Frontend URL
CORS_ORIGIN=http://localhost:5173
