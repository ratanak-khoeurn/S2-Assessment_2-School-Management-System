<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports - School Management System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; } body { margin: 0; min-width: 320px; font-family: Inter, Arial, sans-serif; background: #f1f5f9; color: #172033; }
    .app { min-height: 100vh; display: flex; } .sidebar { width: 270px; flex-shrink: 0; min-height: 100vh; background: #0f172a; color: #fff; } .sidebar-header { height: 65px; display: flex; align-items: center; gap: 10px; padding: 0 18px; border-bottom: 1px solid #1e293b; } .logo { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; background: #3b82f6; font-weight: 700; } .school-name { font-size: 14px; font-weight: 700; white-space: nowrap; } .nav { padding: 15px 10px; } .nav-title { padding: 10px; color: #64748b; font-size: 10px; text-transform: uppercase; } .nav-item { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; padding: 11px 12px; border-radius: 7px; color: #cbd5e1; text-decoration: none; font-size: 13px; } .nav-item:hover { background: #1e293b; color: #fff; } .nav-item.active { background: #2563eb; color: #fff; } .nav-icon { width: 22px; text-align: center; } .main { flex: 1; min-width: 0; } .header { min-height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 30px; background: #fff; border-bottom: 1px solid #e2e8f0; }
    .header-title { font-size: 14px; font-weight: 700; color: #26364f; }.profile { display: flex; gap: 9px; align-items: center; font-size: 12px; }.avatar { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #dbeafe; color: #2563eb; font-weight: 700; }
    .content { max-width: 1440px; padding: 28px 30px 40px; margin: 0 auto; }.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }.page-head h1 { margin: 0; font-size: 25px; letter-spacing: -.03em; }.page-head p { margin: 7px 0 0; color: #64748b; font-size: 13px; }.timestamp { border: 1px solid #dbe4ef; padding: 10px 12px; border-radius: 8px; background: #fff; color: #64748b; font-size: 11px; white-space: nowrap; }
    .notice { padding: 13px 15px; margin-bottom: 18px; border-radius: 8px; background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; font-size: 13px; }.stats { display: grid; grid-template-columns: repeat(4, minmax(165px, 1fr)); gap: 15px; margin-bottom: 18px; }.card { background: #fff; border: 1px solid #e6edf5; border-radius: 11px; padding: 17px; box-shadow: 0 1px 3px rgba(15,23,42,.04); }.card-label { color: #64748b; font-size: 12px; font-weight: 600; }.card-value { margin-top: 10px; font-size: 27px; font-weight: 700; letter-spacing: -.04em; }.card-detail { margin-top: 6px; font-size: 11px; color: #94a3b8; }
    .grid { display: grid; grid-template-columns: minmax(420px, 1.2fr) minmax(300px, .8fr); gap: 18px; }.panel { background: #fff; border: 1px solid #e6edf5; border-radius: 11px; padding: 19px; box-shadow: 0 1px 3px rgba(15,23,42,.04); }.panel h2 { margin: 0; font-size: 14px; }.panel-note { margin: 5px 0 18px; color: #94a3b8; font-size: 11px; }.bars { display: grid; gap: 15px; }.bar-head { display: flex; justify-content: space-between; gap: 12px; color: #475569; font-size: 12px; }.bar-track { height: 8px; margin-top: 7px; overflow: hidden; border-radius: 99px; background: #edf2f7; }.bar-fill { height: 100%; min-width: 2px; border-radius: inherit; background: linear-gradient(90deg, #3b82f6, #60a5fa); }.status-list { display: grid; gap: 10px; }.status-row { display: flex; align-items: center; justify-content: space-between; padding: 11px 12px; border-radius: 8px; background: #f8fafc; color: #475569; font-size: 12px; }.status-row strong { color: #172033; }.empty { padding: 25px 10px; text-align: center; color: #94a3b8; font-size: 12px; }
    .table-panel { margin-top: 18px; overflow: hidden; }.table-wrap { overflow-x: auto; } table { width: 100%; border-collapse: collapse; min-width: 610px; } th { padding: 11px 8px; border-bottom: 1px solid #e9eef5; color: #94a3b8; text-align: left; text-transform: uppercase; font-size: 10px; letter-spacing: .04em; } td { padding: 14px 8px; border-bottom: 1px solid #f0f4f8; color: #475569; font-size: 12px; } tr:last-child td { border-bottom: 0; }.course-name { color: #1e293b; font-weight: 600; }.capacity { min-width: 150px; }.mini-track { height: 6px; margin-top: 6px; overflow: hidden; border-radius: 99px; background: #e8eef6; }.mini-fill { height: 100%; border-radius: inherit; background: #22c55e; }.badge { display: inline-block; padding: 4px 8px; border-radius: 99px; color: #047857; background: #ecfdf5; font-size: 10px; font-weight: 700; }
    @media (max-width: 940px) { .sidebar { width: 220px; } .stats { grid-template-columns: repeat(2, 1fr); }.grid { grid-template-columns: 1fr; } } @media (max-width: 640px) { .sidebar { display: none; } .header, .content { padding-left: 18px; padding-right: 18px; }.page-head { display: block; }.timestamp { display: inline-block; margin-top: 14px; }.stats { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="sidebar-header"><div class="logo">SMS</div><div class="school-name">School Management</div></div>
      <nav class="nav">
        <div class="nav-title">Main Menu</div>
        <a href="/admin/dashboard" class="nav-item"><span class="nav-icon">&#x1F4CA;</span><span>Dashboard</span></a>
        <a href="/departments" class="nav-item"><span class="nav-icon">&#x1F3E2;</span><span>Departments</span></a>
        <a href="/teachers" class="nav-item"><span class="nav-icon">&#x1F468;&#x200D;&#x1F3EB;</span><span>Teachers</span></a>
        <a href="/students" class="nav-item"><span class="nav-icon">&#x1F393;</span><span>Students</span></a>
        <a href="/subjects" class="nav-item"><span class="nav-icon">&#x1F4DA;</span><span>Subjects</span></a>
        <a href="/classes" class="nav-item"><span class="nav-icon">&#x1F3EB;</span><span>Classes</span></a>
        <a href="/attendance" class="nav-item"><span class="nav-icon">&#x1F4C5;</span><span>Attendance</span></a>
        <div class="nav-title">Management</div>
        <a href="/admin/reports" class="nav-item active"><span class="nav-icon">&#x1F4C8;</span><span>Reports</span></a>
        <a href="/settings" class="nav-item"><span class="nav-icon">&#x2699;&#xFE0F;</span><span>Settings</span></a>
      </nav>
    </aside>
    <main class="main">
      <header class="header"><span class="header-title">School Management System</span><div class="profile"><span class="avatar"><%= (admin?.name || 'A').charAt(0).toUpperCase() %></span><span><strong><%= admin?.name || 'Admin' %></strong><br><span style="color:#94a3b8">Administrator</span></span></div></header>
      <section class="content">
        <div class="page-head"><div><h1>Reports &amp; Analytics</h1><p>Live administrative information from the school database.</p></div><div class="timestamp">Generated <%= generatedAt.toLocaleString() %></div></div>
        <% if (typeof error !== 'undefined') { %><div class="notice"><%= error %></div><% } %>
        <% if (summary) { %>
          <div class="stats">
            <article class="card"><div class="card-label">Registered students</div><div class="card-value"><%= summary.studentCount %></div><div class="card-detail">Users assigned the student role</div></article>
            <article class="card"><div class="card-label">Teachers</div><div class="card-value"><%= summary.teacherCount %></div><div class="card-detail">Users assigned the teacher role</div></article>
            <article class="card"><div class="card-label">Courses</div><div class="card-value"><%= summary.courseCount %></div><div class="card-detail">Across <%= summary.activeDepartmentCount %> active department(s)</div></article>
            <article class="card"><div class="card-label">Enrollments</div><div class="card-value"><%= summary.enrollmentCount %></div><div class="card-detail"><%= summary.capacityUsed %>% of listed course capacity</div></article>
          </div>
          <div class="grid">
            <section class="panel"><h2>Courses by department</h2><p class="panel-note">Based on the department value saved on each course.</p><div class="bars"><% if (departments.length) { departments.forEach((department) => { %><div><div class="bar-head"><span><%= department.name %> <span style="color:#94a3b8">(<%= department.code %>)</span></span><strong><%= department.courseCount %> course(s)</strong></div><div class="bar-track"><div class="bar-fill" style="width:<%= department.width %>%"></div></div></div><% }) } else { %><div class="empty">No departments have been created yet.</div><% } %></div></section>
            <section class="panel"><h2>Enrollment status</h2><p class="panel-note">Counts grouped by the status stored on each enrollment.</p><div class="status-list"><% if (enrollmentStatuses.length) { enrollmentStatuses.forEach((item) => { %><div class="status-row"><span><%= item.status %></span><strong><%= item.count %></strong></div><% }) } else { %><div class="empty">No enrollment records are available yet.</div><% } %></div></section>
          </div>
          <section class="panel table-panel"><h2>Recent courses</h2><p class="panel-note">Capacity and enrollment values use the records currently stored in the system.</p><div class="table-wrap"><table><thead><tr><th>Course</th><th>Department</th><th>Capacity</th><th>Enrolled</th><th>Utilisation</th></tr></thead><tbody><% if (courses.length) { courses.forEach((course) => { %><tr><td class="course-name"><%= course.name %></td><td><%= course.department %></td><td><%= course.capacity %></td><td><%= course.enrolled %></td><td class="capacity"><span class="badge"><%= course.fill %>%</span><div class="mini-track"><div class="mini-fill" style="width:<%= course.fill %>%"></div></div></td></tr><% }) } else { %><tr><td colspan="5" class="empty">No courses have been created yet.</td></tr><% } %></tbody></table></div></section>
        <% } %>
      </section>
    </main>
  </div>
</body>
</html>

