<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Departments</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }

        .app {
            display: flex;
            min-height: 100vh;
        }

        .container {
            flex: 1;
            padding: 25px;
        }

        /* HEADER */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .title {
            margin: 0;
            font-size: 24px;
        }

        .subtitle {
            margin-top: 5px;
            color: #64748b;
            font-size: 13px;
        }

        /* BUTTONS */
        .btn {
            border: none;
            border-radius: 7px;
            padding: 10px 16px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
        }

        .btn-primary {
            background: #3b82f6;
            color: white;
        }

        .btn-primary:hover {
            background: #2563eb;
        }

        .btn-secondary {
            background: #e2e8f0;
            color: #334155;
        }

        .btn-danger {
            background: #ef4444;
            color: white;
        }

        /* CONTROLS */
        .controls {
            background: white;
            padding: 14px 18px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
        }

        .search-box {
            position: relative;
            width: 360px;
        }

        .search-box input {
            width: 100%;
            padding: 9px 12px 9px 35px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            outline: none;
        }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 8px;
        }

        .view-switch {
            display: flex;
            gap: 4px;
            background: #f1f5f9;
            padding: 3px;
            border-radius: 6px;
        }

        .view-switch button {
            border: none;
            background: transparent;
            padding: 7px 12px;
            cursor: pointer;
            border-radius: 5px;
        }

        .view-switch button.active {
            background: white;
            font-weight: bold;
            box-shadow: 0 1px 2px rgba(0, 0, 0, .05);
        }

        /* GRID */
        .department-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
        }

        .department-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .department-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .department-code {
            width: 45px;
            height: 45px;
            border-radius: 8px;
            background: #eff6ff;
            color: #3b82f6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            border: 1px solid #bfdbfe;
        }

        .department-name {
            font-size: 15px;
            font-weight: 700;
        }

        .department-id {
            font-size: 11px;
            color: #94a3b8;
            margin-top: 3px;
        }

        .description {
            background: #f8fafc;
            padding: 10px;
            border-radius: 6px;
            font-size: 12px;
            color: #475569;
            min-height: 55px;
        }

        .status {
            font-size: 10px;
            font-weight: bold;
            padding: 4px 9px;
            border-radius: 12px;
        }

        .status-active {
            background: #dcfce7;
            color: #15803d;
        }

        .status-inactive {
            background: #f1f5f9;
            color: #64748b;
        }

        .card-footer {
            margin-top: 18px;
            padding-top: 12px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .date {
            font-size: 11px;
            color: #64748b;
        }

        .actions {
            display: flex;
            gap: 6px;
        }

        .action-btn {
            border: none;
            border-radius: 5px;
            padding: 6px 8px;
            cursor: pointer;
        }

        .view-btn {
            background: #eff6ff;
        }

        .edit-btn {
            background: #fef3c7;
        }

        .delete-btn {
            background: #fef2f2;
        }
        /* ================= DELETE MODAL ================= */

.delete-modal {
    width: 100%;
    max-width: 450px;
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
    animation: deleteModalShow 0.2s ease-out;
}

@keyframes deleteModalShow {
    from {
        opacity: 0;
        transform: scale(0.95) translateY(10px);
    }

    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.delete-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px 0;
    border-bottom: none;
}

.delete-icon {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #fef2f2;
    color: #ef4444;

    border: 1px solid #fecaca;
    border-radius: 50%;

    font-size: 22px;
}

.delete-modal-body {
    padding: 10px 22px 20px;
}

.delete-title {
    margin: 0 0 10px;

    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
}

.delete-message {
    margin: 0;

    font-size: 14px;
    line-height: 1.6;
    color: #475569;
}

.delete-message strong {
    color: #1e293b;
    font-weight: 700;
}

/* Warning box */

.delete-warning {
    display: flex;
    align-items: flex-start;
    gap: 10px;

    margin-top: 18px;
    padding: 12px 14px;

    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: 8px;

    color: #9a3412;
    font-size: 12px;
    line-height: 1.5;
}

.delete-warning span:first-child {
    font-size: 15px;
    flex-shrink: 0;
}

/* Footer */

.delete-modal-footer {
    display: flex;
    justify-content: flex-center;
    gap: 10px;

    padding: 16px 22px;

    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
}

/* Danger button */

.btn-danger {
    background: #ef4444;
    color: #ffffff;

    border: none;
    border-radius: 7px;

    padding: 9px 15px;

    font-size: 13px;
    font-weight: 600;

    cursor: pointer;

    transition: all 0.2s ease;
}

.btn-danger:hover {
    background: #dc2626;
    transform: translateY(-1px);
}

.btn-danger:active {
    transform: translateY(0);
}

.btn-danger:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

        /* TABLE */
        .table-container {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #f8fafc;
            padding: 13px 18px;
            text-align: left;
            font-size: 11px;
            color: #64748b;
            text-transform: uppercase;
        }

        td {
            padding: 14px 18px;
            border-top: 1px solid #f1f5f9;
            font-size: 13px;
        }

        .text-right {
            text-align: right;
        }

        /* EMPTY */
        .empty {
            text-align: center;
            padding: 60px;
            color: #64748b;
        }

        .empty-icon {
            font-size: 45px;
        }

        /* MODAL */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 999;
        }

        .modal {
            width: 500px;
            max-width: 95%;
            background: white;
            border-radius: 10px;
            padding: 20px;
        }

        .modal-sm {
            width: 400px;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-title {
            margin: 0;
            font-size: 18px;
        }

        .close-btn {
            border: none;
            background: transparent;
            font-size: 20px;
            cursor: pointer;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            padding: 9px 11px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            outline: none;
            font-size: 13px;
        }

        textarea.form-control {
            resize: vertical;
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 20px;
        }

        .hidden {
            display: none !important;
        }

        .alert {
            padding: 10px 15px;
            border-radius: 6px;
            margin-bottom: 15px;
        }

        .alert-error {
            background: #fee2e2;
            color: #b91c1c;
        }

        .detail-box {
            background: #f8fafc;
            padding: 15px;
            border-radius: 8px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 13px;
        }

        .detail-label {
            color: #64748b;
        }

        .detail-value {
            font-weight: 600;
        }

        @media (max-width: 700px) {

            .header,
            .controls {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                width: 100%;
            }

            .department-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="app">

        <%- include('../components/sidebar') %>

            <main class="container">

                <!-- HEADER -->
                <header class="header">
                    <div>
                        <h1 class="title">Departments</h1>
                        <p class="subtitle">
                            Manage academic departments and department information.
                        </p>
                    </div>

                    <button type="button" class="btn btn-primary" onclick="openAddModal()">
                        ＋ Add Department
                    </button>
                </header>

                <!-- ERROR -->
                <div id="errorMessage" class="alert alert-error hidden">
                </div>

                <!-- CONTROLS -->
                <section class="controls">

                    <div class="search-box">
                        <span class="search-icon">🔍</span>

                        <input type="search" id="searchInput" placeholder="Search department or code..."
                            oninput="searchDepartments()">
                    </div>

                    <div class="view-switch">

                        <button id="gridButton" class="active" onclick="changeView('grid')">
                            ▦ Grid
                        </button>

                        <button id="tableButton" onclick="changeView('table')">
                            ☰ List
                        </button>

                    </div>

                </section>

                <!-- GRID -->
                <section id="gridView" class="department-grid">
                </section>

                <!-- TABLE -->
                <section id="tableView" class="table-container hidden">

                    <table>

                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Department Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="departmentTableBody">
                        </tbody>

                    </table>

                </section>

                <!-- EMPTY -->
                <div id="emptyMessage" class="empty hidden">

                    <div class="empty-icon">🏢</div>

                    <h2>No departments found</h2>

                    <p>
                        Try another search or create a new department.
                    </p>

                </div>

            </main>
    </div>

     <!-- ADD / EDIT MODAL -->

    <div id="formModal" class="modal-overlay hidden">

        <div class="modal">

            <div class="modal-header">

                <h2 id="formModalTitle">
                    Add New Department
                </h2>

                <button class="close-btn" onclick="closeFormModal()">
                    ✕
                </button>

            </div>

            <form id="departmentForm">

                <input type="hidden" id="departmentId">

                <div class="form-group">

                    <label class="form-label">
                        Department Code *
                    </label>

                    <input type="text" id="departmentCode" class="form-control" placeholder="e.g. IT" required>

                </div>

                <div class="form-group">

                    <label class="form-label">
                        Department Name *
                    </label>

                    <input type="text" id="departmentName" class="form-control"
                        placeholder="e.g. Information Technology" required>

                </div>

                <div class="form-group">

                    <label class="form-label">
                        Description
                    </label>

                    <textarea id="description" class="form-control" rows="3" placeholder="Department description">
                </textarea>

                </div>

                <div class="form-group">

                    <label class="form-label">
                        Status
                    </label>

                    <select id="status" class="form-control">

                        <option value="active">
                            Active
                        </option>

                        <option value="inactive">
                            Inactive
                        </option>

                    </select>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" onclick="closeFormModal()">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary" id="submitButton">
                        Create Department
                    </button>

                </div>

            </form>

        </div>
    </div>

    <!-- VIEW MODAL -->

    <div id="viewModal" class="modal-overlay hidden">

        <div class="modal">

            <div class="modal-header">

                <h2>Department Details</h2>

                <button class="close-btn" onclick="closeViewModal()">
                    ✕
                </button>

            </div>

            <div class="detail-box">

                <div class="detail-row">
                    <span class="detail-label">ID</span>
                    <span id="viewId" class="detail-value"></span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Department Code</span>
                    <span id="viewCode" class="detail-value"></span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Department Name</span>
                    <span id="viewName" class="detail-value"></span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Description</span>
                    <span id="viewDescription" class="detail-value"></span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Status</span>
                    <span id="viewStatus" class="detail-value"></span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Created</span>
                    <span id="viewCreatedAt" class="detail-value"></span>
                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary" onclick="closeViewModal()">
                    Close
                </button>

            </div>

        </div>
    </div>

    <!-- DELETE MODAL -->

    <!-- ================= DELETE CONFIRMATION MODAL ================= -->
    <div id="deleteModal" class="modal-overlay hidden" role="dialog" aria-modal="true">
    
        <div class="modal modal-sm delete-modal">
    
            <!-- Header -->
            <div class="modal-header delete-modal-header">
    
                <div class="delete-icon">
                    🗑️
                </div>
    
                <button type="button" class="close-btn" onclick="closeDeleteModal()" aria-label="Close">
                    ✕
                </button>
    
            </div>
    
            <!-- Content -->
            <div class="delete-modal-body">
    
                <h2 class="delete-title">
                    Delete Department?
                </h2>
    
                <p class="delete-message">
                    Are you sure you want to delete
                    <strong id="deleteDepartmentName"></strong>?
                </p>
    
                <div class="delete-warning">
                    <span>⚠️</span>
                    <span>
                        This action cannot be undone. All information associated
                        with this department may be permanently removed.
                    </span>
                </div>
    
            </div>
    
            <!-- Footer -->
            <div class="modal-footer delete-modal-footer">
    
                <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">
                    Cancel
                </button>
    
                <button type="button" id="confirmDeleteButton" class="btn btn-danger" onclick="confirmDelete()">
                    🗑️ Delete
                </button>
    
            </div>
    
        </div>
    
    </div>


    <script>

        // VARIABLES

        let departments = [];
        let currentView = "grid";
        let deletingDepartmentId = null;

        // LOAD DEPARTMENTS

        async function loadDepartments() {

            try {

                hideError();

                const response = await fetch("/api/departments");

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.message || "Failed to load departments");
                }

                departments = result.data || [];

                renderDepartments();

            } catch (error) {

                console.error("Load departments error:", error);

                showError(error.message);

            }

        }
        
        // RENDER

        function renderDepartments() {

            const searchValue =
                document
                    .getElementById("searchInput")
                    .value
                    .toLowerCase()
                    .trim();

            const filtered = departments.filter(dep => {

                return (
                    dep.departmentCode
                        .toLowerCase()
                        .includes(searchValue)
                    ||
                    dep.departmentName
                        .toLowerCase()
                        .includes(searchValue)
                );

            });

            const grid = document.getElementById("gridView");

            const tableBody =
                document.getElementById("departmentTableBody");

            grid.innerHTML = "";
            tableBody.innerHTML = "";


            if (filtered.length === 0) {

                document
                    .getElementById("emptyMessage")
                    .classList.remove("hidden");

                return;

            }

            document
                .getElementById("emptyMessage")
                .classList.add("hidden");


            // GRID

            filtered.forEach(dep => {

                const card = document.createElement("div");

                card.className = "department-card";

                card.innerHTML = `

                <div class="card-header">

                    <div class="department-info">

                        <div>

                            <div class="department-name">
                                ${escapeHtml(dep.departmentName)}
                            </div>

                            <div class="department-id">
                                ID: ${escapeHtml(dep.departmentCode)}
                            </div>

                        </div>

                    </div>

                    <span class="status
                        ${dep.status === "active"
                        ? "status-active"
                        : "status-inactive"}">

                        ${escapeHtml(dep.status)}

                    </span>

                </div>


                <div class="description">

                    ${dep.description
                        ? escapeHtml(dep.description)
                        : "No description available."
                    }

                </div>


                <div class="card-footer">

                    <div class="date">

                        Created:
                        ${formatDate(dep.createdAt)}

                    </div>

                    <div class="actions">

                        <button
                            class="action-btn view-btn"
                            onclick="viewDepartment(${dep.id})"
                            title="View">
                            👁️
                        </button>

                        <button
                            class="action-btn edit-btn"
                            onclick="editDepartment(${dep.id})"
                            title="Edit">
                            ✏️
                        </button>

                        <button
                            class="action-btn delete-btn"
                            onclick="openDeleteModal(${dep.id}, '${escapeAttribute(dep.departmentName)}')"
                            title="Delete">
                            🗑️
                        </button>

                    </div>

                </div>

            `;

                grid.appendChild(card);

            });


            // TABLE

            filtered.forEach(dep => {

                const row = document.createElement("tr");

                row.innerHTML = `

                <td>
                    ${escapeHtml(dep.departmentCode)}
                </td>

                <td>
                    <strong>
                        ${escapeHtml(dep.departmentName)}
                    </strong>
                </td>

                <td>
                    ${dep.description
                        ? escapeHtml(dep.description)
                        : "-"
                    }
                </td>

                <td>

                    <span class="status
                        ${dep.status === "active"
                        ? "status-active"
                        : "status-inactive"}">

                        ${escapeHtml(dep.status)}

                    </span>

                </td>

                <td>
                    ${formatDate(dep.createdAt)}
                </td>

                <td class="text-right">

                    <button
                        class="action-btn view-btn"
                        onclick="viewDepartment(${dep.id})">
                        👁️
                    </button>

                    <button
                        class="action-btn edit-btn"
                        onclick="editDepartment(${dep.id})">
                        ✏️
                    </button>

                    <button
                        class="action-btn delete-btn"
                        onclick="openDeleteModal(${dep.id}, '${escapeAttribute(dep.departmentName)}')">
                        🗑️
                    </button>

                </td>

            `;

                tableBody.appendChild(row);

            });

        }


        // ==========================================
        // SEARCH
        // ==========================================

        function searchDepartments() {
            renderDepartments();
        }


        // ==========================================
        // CHANGE VIEW
        // ==========================================

        function changeView(view) {

            currentView = view;

            const grid =
                document.getElementById("gridView");

            const table =
                document.getElementById("tableView");

            const gridButton =
                document.getElementById("gridButton");

            const tableButton =
                document.getElementById("tableButton");


            if (view === "grid") {

                grid.classList.remove("hidden");
                table.classList.add("hidden");

                gridButton.classList.add("active");
                tableButton.classList.remove("active");

            } else {

                grid.classList.add("hidden");
                table.classList.remove("hidden");

                gridButton.classList.remove("active");
                tableButton.classList.add("active");

            }

        }


        // ==========================================
        // ADD MODAL
        // ==========================================

        function openAddModal() {

            document.getElementById("formModalTitle").textContent =
                "Add New Department";

            document.getElementById("submitButton").textContent =
                "Create Department";

            document.getElementById("departmentId").value = "";

            document.getElementById("departmentCode").value = "";

            document.getElementById("departmentName").value = "";

            document.getElementById("description").value = "";

            document.getElementById("status").value = "active";

            document
                .getElementById("formModal")
                .classList.remove("hidden");

        }


        function closeFormModal() {

            document
                .getElementById("formModal")
                .classList.add("hidden");

        }


        // ==========================================
        // CREATE / UPDATE
        // ==========================================

        document
            .getElementById("departmentForm")
            .addEventListener("submit", async function (event) {

                event.preventDefault();

                const id =
                    document.getElementById("departmentId").value;

                const data = {

                    departmentCode:
                        document
                            .getElementById("departmentCode")
                            .value
                            .trim(),

                    departmentName:
                        document
                            .getElementById("departmentName")
                            .value
                            .trim(),

                    description:
                        document
                            .getElementById("description")
                            .value
                            .trim(),

                    status:
                        document
                            .getElementById("status")
                            .value

                };


                try {

                    const response = await fetch(
                        id
                            ? `/api/departments/${id}`
                            : "/api/departments",
                        {

                            method: id ? "PUT" : "POST",

                            headers: {
                                "Content-Type": "application/json"
                            },

                            body: JSON.stringify(data)

                        }
                    );


                    const result = await response.json();


                    if (!response.ok) {

                        throw new Error(
                            result.message ||
                            "Request failed"
                        );

                    }


                    closeFormModal();

                    await loadDepartments();


                } catch (error) {

                    console.error(error);

                    showError(error.message);

                }

            });


        // ==========================================
        // EDIT
        // ==========================================

        async function editDepartment(id) {

            try {

                const response =
                    await fetch(`/api/departments/${id}`);

                const result =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        result.message ||
                        "Failed to get department"
                    );

                }


                const dep = result.data;


                document.getElementById("departmentId").value =
                    dep.id;

                document.getElementById("departmentCode").value =
                    dep.departmentCode;

                document.getElementById("departmentName").value =
                    dep.departmentName;

                document.getElementById("description").value =
                    dep.description || "";

                document.getElementById("status").value =
                    dep.status;


                document.getElementById("formModalTitle").textContent =
                    "Edit Department";

                document.getElementById("submitButton").textContent =
                    "Save Changes";


                document
                    .getElementById("formModal")
                    .classList.remove("hidden");


            } catch (error) {

                showError(error.message);

            }

        }


        // ==========================================
        // VIEW
        // ==========================================

        async function viewDepartment(id) {

            try {

                const response =
                    await fetch(`/api/departments/${id}`);

                const result =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        result.message ||
                        "Failed to get department"
                    );

                }


                const dep = result.data;


                document.getElementById("viewId").textContent =
                    dep.id;

                document.getElementById("viewCode").textContent =
                    dep.departmentCode;

                document.getElementById("viewName").textContent =
                    dep.departmentName;

                document.getElementById("viewDescription").textContent =
                    dep.description || "-";

                document.getElementById("viewStatus").textContent =
                    dep.status;

                document.getElementById("viewCreatedAt").textContent =
                    formatDate(dep.createdAt);


                document
                    .getElementById("viewModal")
                    .classList.remove("hidden");


            } catch (error) {

                showError(error.message);

            }

        }


        function closeViewModal() {

            document
                .getElementById("viewModal")
                .classList.add("hidden");

        }


        // ==========================================
        // DELETE
        // ==========================================

        function openDeleteModal(id, name) {

            deletingDepartmentId = id;

            document
                .getElementById("deleteDepartmentName")
                .textContent = name;

            document
                .getElementById("deleteModal")
                .classList.remove("hidden");

        }


        function closeDeleteModal() {

            deletingDepartmentId = null;

            document
                .getElementById("deleteModal")
                .classList.add("hidden");

        }


        async function confirmDelete() {

            if (!deletingDepartmentId) {
                return;
            }


            try {

                const response =
                    await fetch(
                        `/api/departments/${deletingDepartmentId}`,
                        {
                            method: "DELETE"
                        }
                    );


                const result =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        result.message ||
                        "Failed to delete department"
                    );

                }


                closeDeleteModal();

                await loadDepartments();


            } catch (error) {

                console.error(error);

                showError(error.message);

            }

        }


        // ==========================================
        // ERROR
        // ==========================================

        function showError(message) {

            const element =
                document.getElementById("errorMessage");

            element.textContent = message;

            element.classList.remove("hidden");

        }


        function hideError() {

            document
                .getElementById("errorMessage")
                .classList.add("hidden");

        }


        // ==========================================
        // HELPERS
        // ==========================================

        function formatDate(date) {

            if (!date) return "-";

            return new Date(date).toLocaleDateString();

        }


        function escapeHtml(value) {

            if (value === null || value === undefined) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        function escapeAttribute(value) {

            if (!value) return "";

            return String(value)
                .replace(/\\/g, "\\\\")
                .replace(/'/g, "\\'")
                .replace(/"/g, "&quot;");

        }


        // ==========================================
        // START
        // ==========================================

        loadDepartments();

    </script>

</body>

</html>